{
  "vsicons.dontShowNewVersionMessage": true,
  "atomKeymap.promptV3Features": true,
  "editor.multiCursorModifier": "ctrlCmd",
  "editor.formatOnPaste": true,
  "editor.tabSize": 2,
  "editor.rulers": [80, 100],
  "editor.fontFamily": "Monaspace Krypton Var, Input Mono, Operator Mono, Monaco, 'Courier New', monospace",
  "editor.fontSize": 14,
  "files.associations": {
    ".exports": "shellscript",
    ".bash_prompt": "shellscript",
    ".aliases": "shellscript",
    ".functions": "shellscript",
    ".path": "shellscript",
    ".private": "shellscript",
    "Brewfile": "properties",
    "*.webc": "html"
  },
  "workbench.startupEditor": "newUntitledFile",
  "files.insertFinalNewline": true,
  "files.autoSave": "onFocusChange",
  "editor.formatOnSave": true,
  "javascript.updateImportsOnFileMove.enabled": "always",
  "editor.defaultFormatter": "esbenp.prettier-vscode",
  "[typescript]": {
    "editor.defaultFormatter": "vscode.typescript-language-features"
  },
  "github.copilot.advanced": {},
  "workbench.settings.applyToAllProfiles": [
    "github.copilot.chat.agent.runTasks"
  ],
  "editor.quickSuggestions": {
    "strings": "on"
  },
  "tailwindCSS.includeLanguages": {
    "erb": "html"
  },
  "workbench.iconTheme": "charmed-warm",
  "workbench.colorTheme": "One Dark Pro Night Flat",
  "workbench.secondarySideBar.defaultVisibility": "hidden",
  "workbench.editor.showTabs": "single",
  "vscoconut.airbnb-project-view.groupingMode": "prefix",
  "security.promptForLocalFileProtocolHandling": false,
  "claudeCode.preferredLocation": "panel"
}
